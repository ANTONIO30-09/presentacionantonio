/* Global styles — iPortfolio template */
html {
  scroll-behavior: smooth;
}

/* Fix AOS para Angular */
[data-aos] {
  opacity: 1 !important;
  transform: none !important;
  transition: none !important;
}

/* ============================================
   Mejoras de diseño — Portafolio Antonio
   ============================================ */

/* About: título destacado */
.about .content h2 {
  font-size: 28px;
  font-weight: 700;
  color: #173b6c;
  line-height: 1.3;
  margin-bottom: 20px;
}

.about .content .fst-italic {
  font-size: 16px;
  color: #0563bb;
  border-left: 4px solid #0563bb;
  padding-left: 16px;
  font-weight: 500;
}

/* About: lista de datos */
.about .content ul {
  list-style: none;
  padding: 0;
}

.about .content ul li {
  padding: 8px 0;
  border-bottom: 1px solid #f0f0f0;
  display: flex;
  align-items: center;
}

.about .content ul li i {
  color: #0563bb;
  font-size: 14px;
  margin-right: 8px;
}

.about .content ul li strong {
  color: #173b6c;
  margin-right: 8px;
  min-width: 90px;
  display: inline-block;
}

/* Skills: barras más modernas */
.skills .progress {
  height: auto;
  padding: 0;
  border-radius: 10px;
  background: transparent;
  margin-bottom: 25px;
}

.skills .progress .skill {
  font-size: 14px;
  font-weight: 600;
  color: #173b6c;
  margin-bottom: 8px;
  display: flex;
  justify-content: space-between;
}

.skills .progress-bar-wrap {
  background: #e8e8e8;
  height: 10px;
  border-radius: 10px;
  overflow: hidden;
}

.skills .progress-bar {
  background: linear-gradient(90deg, #0563bb, #4da3ff);
  border-radius: 10px;
  height: 100%;
  transition: width 1s ease-in-out;
}

/* Portfolio: tarjetas más elegantes */
.portfolio .portfolio-content {
  border-radius: 12px;
  box-shadow: 0 5px 25px rgba(0, 0, 0, 0.08);
  transition: transform 0.3s ease;
}

.portfolio .portfolio-content:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 35px rgba(5, 99, 187, 0.15);
}

/* Resume: títulos */
.resume .resume-title {
  font-size: 26px;
  font-weight: 700;
  color: #173b6c;
  margin-bottom: 20px;
  padding-bottom: 10px;
  border-bottom: 2px solid #0563bb;
  display: inline-block;
}

.resume .resume-item h4 {
  font-size: 18px;
  font-weight: 700;
  color: #0563bb;
}

/* Section titles más elegantes */
.section-title h2 {
  font-size: 32px;
  font-weight: 700;
  color: #173b6c;
  margin-bottom: 15px;
  padding-bottom: 15px;
  position: relative;
}

.section-title h2::after {
  content: "";
  position: absolute;
  display: block;
  width: 50px;
  height: 3px;
  background: #0563bb;
  bottom: 0;
  left: 0;
}

.section-title p {
  color: #6c757d;
  font-size: 15px;
  line-height: 1.6;
}

/* Scrollbar personalizado */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: #f1f1f1;
}

::-webkit-scrollbar-thumb {
  background: #0563bb;
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: #045195;
}

/* Animación suave de entrada */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.section {
  animation: fadeInUp 0.6s ease-out;
}

/* ============================================
   Facts / Stats - Diseño mejorado
   ============================================ */
.facts .stats-item {
  padding: 30px 20px;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 5px 25px rgba(0, 0, 0, 0.06);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  border: 1px solid rgba(5, 99, 187, 0.08);
}

.facts .stats-item:hover {
  transform: translateY(-6px);
  box-shadow: 0 15px 40px rgba(5, 99, 187, 0.15);
}

.facts .stats-item i {
  font-size: 42px;
  margin-right: 20px;
  line-height: 0;
  transition: transform 0.3s ease;
}

.facts .stats-item:hover i {
  transform: scale(1.15);
}

.facts .stats-item span {
  font-size: 32px;
  display: block;
  font-weight: 700;
  color: #173b6c;
  line-height: 1;
  margin-bottom: 6px;
}

.facts .stats-item p {
  padding: 0;
  margin: 0;
  font-size: 14px;
  font-weight: 500;
  color: #6c757d;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* Colores personalizados para iconos */
.facts .color-blue   { color: #0563bb; }
.facts .color-orange { color: #ff8c00; }
.facts .color-green  { color: #28a745; }
.facts .color-pink   { color: #e83e8c; }

/* About: lista más compacta */
.about .content ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
}

.about .content ul li {
  width: 100%;
  padding: 10px 0;
  border-bottom: 1px solid #eef1f5;
  color: #555;
  font-size: 15px;
}

.about .content ul li:last-child {
  border-bottom: none;
}

.about .content ul li strong {
  color: #173b6c;
  font-weight: 600;
  min-width: 100px;
  display: inline-block;
}

/* ============================================
   Stats Section — Diseño mejorado
   ============================================ */
.stats .stats-item {
  padding: 30px 25px;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 5px 25px rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  border: 1px solid rgba(5, 99, 187, 0.08);
  display: flex;
  align-items: center;
  gap: 18px;
  height: 100%;
}

.stats .stats-item:hover {
  transform: translateY(-6px);
  box-shadow: 0 15px 40px rgba(5, 99, 187, 0.15);
  border-color: rgba(5, 99, 187, 0.2);
}

.stats .stats-item i {
  font-size: 48px;
  line-height: 1;
  color: #0563bb;
  transition: transform 0.3s ease;
  flex-shrink: 0;
}

.stats .stats-item:hover i {
  transform: scale(1.15) rotate(-5deg);
}

.stats .stats-item > div {
  flex: 1;
}

.stats .stats-item span.purecounter {
  display: block;
  font-size: 36px;
  font-weight: 700;
  color: #173b6c;
  line-height: 1;
  margin-bottom: 6px;
  font-family: 'Raleway', sans-serif;
}

.stats .stats-item p {
  margin: 0;
  padding: 0;
  font-size: 13px;
  color: #6c757d;
  line-height: 1.3;
}

.stats .stats-item p strong {
  display: block;
  color: #45505b;
  font-weight: 700;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 2px;
}

.stats .stats-item p span {
  color: #8896a5;
  font-weight: 400;
}

/* Colores distintos por icono */
.stats .col-lg-3:nth-child(1) .stats-item i { color: #0563bb; }
.stats .col-lg-3:nth-child(2) .stats-item i { color: #ff8c00; }
.stats .col-lg-3:nth-child(3) .stats-item i { color: #28a745; }
.stats .col-lg-3:nth-child(4) .stats-item i { color: #e83e8c; }

/* ============================================
   DISEÑO GENERAL — Secciones de la derecha
   ============================================ */

/* Fondo alternado para secciones */
.section {
  padding: 60px 0;
}

.section.light-background {
  background: #f8f9fa;
}

/* ============================================
   SKILLS - Barras modernas
   ============================================ */
.skills .progress {
  height: auto;
  border-radius: 0;
  background: transparent;
  margin-bottom: 22px;
}

.skills .progress .skill {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
  font-size: 14px;
  font-weight: 600;
  color: #173b6c;
  text-transform: none;
  letter-spacing: 0;
}

.skills .progress .skill .val {
  font-style: normal;
  font-weight: 700;
  color: #0563bb;
  font-size: 14px;
}

.skills .progress-bar-wrap {
  background: #e8ecf1;
  height: 10px;
  border-radius: 10px;
  overflow: hidden;
  position: relative;
}

.skills .progress-bar {
  background: linear-gradient(90deg, #0563bb 0%, #4da3ff 100%);
  border-radius: 10px;
  height: 100%;
  transition: width 1.2s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.skills .progress-bar::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
  animation: shine 2s infinite;
}

@keyframes shine {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

/* ============================================
   RESUME - Timeline elegante
   ============================================ */
.resume .resume-title {
  font-size: 24px;
  font-weight: 700;
  color: #173b6c;
  margin-bottom: 25px;
  padding-bottom: 12px;
  position: relative;
  display: inline-block;
}

.resume .resume-title::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 40px;
  height: 3px;
  background: #0563bb;
}

.resume .resume-item {
  padding: 0 0 25px 25px;
  margin-top: -2px;
  border-left: 2px solid #0563bb;
  position: relative;
  transition: all 0.3s ease;
}

.resume .resume-item:hover {
  border-left-color: #4da3ff;
  background: linear-gradient(90deg, rgba(5, 99, 187, 0.02), transparent);
  padding-left: 30px;
}

.resume .resume-item::before {
  content: "";
  position: absolute;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  left: -8px;
  top: 0;
  background: #fff;
  border: 2px solid #0563bb;
  transition: all 0.3s ease;
}

.resume .resume-item:hover::before {
  background: #0563bb;
  box-shadow: 0 0 0 4px rgba(5, 99, 187, 0.15);
}

.resume .resume-item h4 {
  font-size: 17px;
  font-weight: 700;
  color: #173b6c;
  margin-bottom: 6px;
}

.resume .resume-item h5 {
  font-size: 13px;
  background: #0563bb;
  color: #fff;
  padding: 4px 12px;
  border-radius: 20px;
  display: inline-block;
  margin-bottom: 10px;
  font-weight: 600;
}

.resume .resume-item em {
  color: #0563bb;
  font-style: italic;
  font-weight: 500;
  font-size: 14px;
}

.resume .resume-item ul {
  padding-left: 18px;
  margin-top: 10px;
}

.resume .resume-item ul li {
  padding-bottom: 6px;
  color: #555;
  font-size: 14px;
  line-height: 1.6;
}

/* ============================================
   SERVICES - Cards elegantes
   ============================================ */
.services .service-item {
  padding: 35px 25px;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 5px 25px rgba(0, 0, 0, 0.05);
  transition: all 0.35s ease;
  height: 100%;
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(5, 99, 187, 0.06);
}

.services .service-item::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 0;
  background: #0563bb;
  transition: height 0.35s ease;
}

.services .service-item:hover::before {
  height: 100%;
}

.services .service-item:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 45px rgba(5, 99, 187, 0.12);
}

.services .service-item .icon {
  width: 64px;
  height: 64px;
  background: linear-gradient(135deg, #0563bb, #4da3ff);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  transition: transform 0.3s ease;
}

.services .service-item:hover .icon {
  transform: scale(1.1) rotate(-5deg);
}

.services .service-item .icon i {
  font-size: 28px;
  color: #fff;
}

.services .service-item h3,
.services .service-item h4 {
  font-size: 20px;
  font-weight: 700;
  color: #173b6c;
  margin-bottom: 12px;
}

.services .service-item p {
  color: #6c757d;
  font-size: 14px;
  line-height: 1.7;
  margin: 0;
}

/* ============================================
   PORTFOLIO - Filtros y cards
   ============================================ */
.portfolio .portfolio-filters {
  padding: 0;
  margin: 0 auto 40px;
  list-style: none;
  text-align: center;
}

.portfolio .portfolio-filters li {
  cursor: pointer;
  display: inline-block;
  padding: 8px 20px;
  font-size: 14px;
  font-weight: 600;
  border-radius: 30px;
  margin: 5px 4px;
  color: #45505b;
  transition: all 0.3s ease;
  background: #fff;
  border: 1px solid #e8ecf1;
}

.portfolio .portfolio-filters li:hover,
.portfolio .portfolio-filters li.filter-active {
  color: #fff;
  background: #0563bb;
  border-color: #0563bb;
  box-shadow: 0 5px 15px rgba(5, 99, 187, 0.3);
}

.portfolio .portfolio-content {
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  transition: all 0.35s ease;
  position: relative;
}

.portfolio .portfolio-content:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 45px rgba(5, 99, 187, 0.18);
}

.portfolio .portfolio-content img {
  transition: transform 0.6s ease;
}

.portfolio .portfolio-content:hover img {
  transform: scale(1.08);
}

.portfolio .portfolio-info {
  background: linear-gradient(135deg, rgba(5, 99, 187, 0.95), rgba(77, 163, 255, 0.9));
  backdrop-filter: blur(4px);
}

.portfolio .portfolio-info h4 {
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 8px;
  letter-spacing: 0.3px;
}

.portfolio .portfolio-info p {
  font-size: 13px;
  line-height: 1.5;
  margin-bottom: 15px;
  opacity: 0.95;
}

/* ============================================
   CONTACT - Info items y formulario
   ============================================ */
.contact .info-wrap {
  padding: 30px;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 5px 25px rgba(0, 0, 0, 0.05);
  height: 100%;
}

.contact .info-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 25px;
  padding: 15px;
  border-radius: 10px;
  transition: background 0.3s ease;
}

.contact .info-item:hover {
  background: rgba(5, 99, 187, 0.04);
}

.contact .info-item i {
  font-size: 22px;
  color: #0563bb;
  background: rgba(5, 99, 187, 0.1);
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  margin-right: 15px;
  flex-shrink: 0;
}

.contact .info-item h3 {
  font-size: 16px;
  font-weight: 700;
  color: #173b6c;
  margin: 0 0 4px;
}

.contact .info-item p {
  margin: 0;
  color: #6c757d;
  font-size: 14px;
}

/* ============================================
   SECTION TITLES - Estilo unificado
   ============================================ */
.section-title {
  text-align: left;
  padding-bottom: 30px;
}

.section-title h2 {
  font-size: 32px;
  font-weight: 700;
  color: #173b6c;
  margin-bottom: 10px;
  padding-bottom: 15px;
  position: relative;
}

.section-title h2::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 50px;
  height: 3px;
  background: #0563bb;
}

.section-title p {
  color: #6c757d;
  font-size: 15px;
  line-height: 1.6;
  margin: 0;
}

/* ============================================
   RESUME - Header (About me)
   ============================================ */
.resume .resume-item .resume-header {
  margin-bottom: 10px;
}

/* Responsive */
@media (max-width: 768px) {
  .section-title h2 { font-size: 26px; }
  .section { padding: 40px 0; }
}

/* ============================================
   PORTFOLIO — Tarjetas de proyectos SIN imágenes
   ============================================ */
.portfolio .portfolio-filters {
  padding: 0;
  margin: 0 auto 40px;
  list-style: none;
  text-align: center;
}

.portfolio .portfolio-filters li {
  cursor: pointer;
  display: inline-block;
  padding: 9px 22px;
  font-size: 14px;
  font-weight: 600;
  border-radius: 30px;
  margin: 5px 5px;
  color: #45505b;
  background: #fff;
  border: 1px solid #e8ecf1;
  transition: all 0.3s ease;
}

.portfolio .portfolio-filters li:hover,
.portfolio .portfolio-filters li.filter-active {
  color: #fff;
  background: #0563bb;
  border-color: #0563bb;
  box-shadow: 0 8px 20px rgba(5, 99, 187, 0.3);
  transform: translateY(-2px);
}

/* Tarjeta de proyecto */
.project-card {
  display: flex;
  gap: 20px;
  padding: 28px;
  background: #fff;
  border-radius: 16px;
  text-decoration: none;
  color: inherit;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  height: 100%;
  border: 1px solid rgba(5, 99, 187, 0.06);
  position: relative;
  overflow: hidden;
}

.project-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4px;
  background: linear-gradient(90deg, #0563bb, #4da3ff);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.4s ease;
}

.project-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 50px rgba(5, 99, 187, 0.15);
  border-color: rgba(5, 99, 187, 0.15);
}

.project-card:hover::before {
  transform: scaleX(1);
}

/* Icono del proyecto */
.project-icon {
  width: 70px;
  height: 70px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.35s ease;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
}

.project-card:hover .project-icon {
  transform: scale(1.1) rotate(-6deg);
}

.project-icon i {
  font-size: 32px;
  color: #fff;
}

.icon-ai {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.icon-app {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.icon-tools {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.icon-web {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

/* Contenido del proyecto */
.project-content {
  flex: 1;
  min-width: 0;
}

.project-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 10px;
}

.project-header h4 {
  font-size: 19px;
  font-weight: 700;
  color: #173b6c;
  margin: 0;
  transition: color 0.3s ease;
}

.project-card:hover .project-header h4 {
  color: #0563bb;
}

.project-badge {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 4px 10px;
  border-radius: 20px;
  background: rgba(5, 99, 187, 0.1);
  color: #0563bb;
  white-space: nowrap;
}

.project-content > p {
  font-size: 14px;
  line-height: 1.6;
  color: #6c757d;
  margin: 0 0 14px;
}

/* Tags de tecnologías */
.project-tech {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 14px;
}

.project-tech span {
  font-size: 11px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 6px;
  background: #f2f5f9;
  color: #45505b;
  transition: all 0.3s ease;
}

.project-card:hover .project-tech span {
  background: rgba(5, 99, 187, 0.08);
  color: #0563bb;
}

/* Link al final */
.project-link {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 700;
  color: #0563bb;
  padding-top: 14px;
  border-top: 1px solid #eef1f5;
  transition: gap 0.3s ease;
}

.project-link i:first-child {
  font-size: 16px;
}

.project-link i:last-child {
  margin-left: auto;
  transition: transform 0.3s ease;
}

.project-card:hover .project-link {
  gap: 12px;
}

.project-card:hover .project-link i:last-child {
  transform: translateX(5px);
}

/* Responsive */
@media (max-width: 768px) {
  .project-card {
    flex-direction: column;
    padding: 22px;
  }

  .project-icon {
    width: 56px;
    height: 56px;
  }

  .project-icon i {
    font-size: 26px;
  }

  .project-header h4 {
    font-size: 17px;
  }
}

/* ============================================
   SERVICES — Tarjetas modernas
   ============================================ */
.services .service-item {
  padding: 35px 30px;
  background: #fff;
  border-radius: 16px;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  height: 100%;
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(5, 99, 187, 0.06);
  display: flex;
  flex-direction: column;
}

.services .service-item::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4px;
  background: linear-gradient(90deg, #0563bb, #4da3ff);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.4s ease;
}

.services .service-item:hover::before {
  transform: scaleX(1);
}

.services .service-item:hover {
  transform: translateY(-10px);
  box-shadow: 0 25px 60px rgba(5, 99, 187, 0.15);
  border-color: rgba(5, 99, 187, 0.15);
}

.services .service-item .icon {
  width: 70px;
  height: 70px;
  background: linear-gradient(135deg, #0563bb, #4da3ff);
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22px;
  transition: all 0.4s ease;
  box-shadow: 0 10px 25px rgba(5, 99, 187, 0.25);
  position: relative;
}

.services .service-item .icon::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(255,255,255,0.3), transparent);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.services .service-item:hover .icon {
  transform: scale(1.08) rotate(-6deg);
  box-shadow: 0 15px 35px rgba(5, 99, 187, 0.35);
}

.services .service-item:hover .icon::after {
  opacity: 1;
}

.services .service-item .icon i {
  font-size: 32px;
  color: #fff;
  position: relative;
  z-index: 1;
}

.services .service-item h3 {
  font-size: 20px;
  font-weight: 700;
  color: #173b6c;
  margin-bottom: 14px;
  transition: color 0.3s ease;
}

.services .service-item:hover h3 {
  color: #0563bb;
}

.services .service-item p {
  color: #6c757d;
  font-size: 14.5px;
  line-height: 1.7;
  margin: 0;
}

/* Responsive */
@media (max-width: 768px) {
  .services .service-item {
    padding: 25px 22px;
  }

  .services .service-item .icon {
    width: 60px;
    height: 60px;
  }

  .services .service-item .icon i {
    font-size: 26px;
  }

  .services .service-item h3 {
    font-size: 18px;
  }
}
